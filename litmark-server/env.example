# --- Search & scoring ---
ANTHROPIC_API_KEY=

# Optional — raises your OpenAlex rate limit, costs nothing, no signup needed
CONTACT_EMAIL=you@example.com

# Optional — higher Semantic Scholar rate limit: https://www.semanticscholar.org/product/api
SEMANTIC_SCHOLAR_API_KEY=

# Optional — raises PubMed/PMC's rate limit from 3/sec to 10/sec, free:
# https://www.ncbi.nlm.nih.gov/account/settings/ (once logged in, API Key Management)
NCBI_API_KEY=

PORT=3787

# Restrict the API to your own frontend once deployed
ALLOWED_ORIGIN=https://litmark.org

# --- Subscriptions (Stripe) ---
# Secret key from https://dashboard.stripe.com/apikeys — starts with sk_live_ or sk_test_
STRIPE_SECRET_KEY=

# The Price ID of your monthly subscription product — starts with price_
STRIPE_PRICE_ID=

# --- Passwordless login ---
# Any long random string — used to sign login tokens. Generate one with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Your live frontend URL — used to build checkout/login redirect links
APP_URL=https://litmark.org

# --- Sending login emails (Resend) ---
# From https://resend.com/api-keys
RESEND_API_KEY=

# Who login emails appear to be from. Use the default below until you've
# verified litmark.org as a sending domain in Resend; then switch to
# something like "LitMark <login@litmark.org>"
FROM_EMAIL=LitMark <onboarding@resend.dev>


# --- Search reuse and source alerts (all optional) ---
# How many hours a finished search is reused when another student asks the same
# question (cohorts are usually set the same one). Saves OpenAlex credits, AI
# cost and waiting time. 0 switches it off. Default 12.
SEARCH_CACHE_HOURS=12

# The "Official data" card on Find sources: a headline figure (with its definition
# and a ready citation) from the World Bank's open data service, shown above the
# papers when a question asks how common or how big something is. Set to "off" to
# hide it. Needs no key.
OFFICIAL_DATA=on

# Who is emailed when a literature source stops answering. Comma-separated.
# Leave empty for no emails (alerts are then only written to the logs).
# Does not use ADMIN_EMAILS.
ALERT_EMAIL=

# How many searches in a row a source must return nothing for before you are
# emailed. Default 5.
SOURCE_ALERT_AFTER=5

# Which sources to watch, comma-separated: OpenAlex, Semantic Scholar, Crossref,
# Europe PMC, CORE, DOAJ, ERIC, All sources. Leave empty for the sensible
# default: OpenAlex, Semantic Scholar (only if SEMANTIC_SCHOLAR_API_KEY is set),
# and All sources.
SOURCE_ALERT_WATCH=


# --- Saved folders and usage limits ---
# Postgres connection string. Without it, saved folders stay in one browser and
# do not follow a student between devices. If you run scripts/library-tool.js
# (backups) from your own computer, use the database's EXTERNAL connection string.
DATABASE_URL=

# How much one account can do per hour, counted in searches. A search or a
# citation check counts 1, summarising a folder or adding a paper by DOI counts
# 0.5, and a Vera question or one paper's summary counts 0.25. Default 20.
RATE_LIMIT_MAX=20
