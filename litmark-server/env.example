# --- Search & scoring ---
ANTHROPIC_API_KEY=

# Optional — raises your OpenAlex rate limit, costs nothing, no signup needed
CONTACT_EMAIL=you@example.com

# Optional — higher Semantic Scholar rate limit: https://www.semanticscholar.org/product/api
SEMANTIC_SCHOLAR_API_KEY=

# Optional — raises PubMed/PMC's rate limit from 3/sec to 10/sec, free:
# https://www.ncbi.nlm.nih.gov/account/settings/ (once logged in, API Key Management)
NCBI_API_KEY=

PORT=3787

# Restrict the API to your own frontend once deployed
ALLOWED_ORIGIN=https://litmark.org

# --- Subscriptions (Stripe) ---
# Secret key from https://dashboard.stripe.com/apikeys — starts with sk_live_ or sk_test_
STRIPE_SECRET_KEY=

# The Price ID of your monthly subscription product — starts with price_
STRIPE_PRICE_ID=

# --- Passwordless login ---
# Any long random string — used to sign login tokens. Generate one with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Your live frontend URL — used to build checkout/login redirect links
APP_URL=https://litmark.org

# --- Sending login emails (Resend) ---
# From https://resend.com/api-keys
RESEND_API_KEY=

# Who login emails appear to be from. Use the default below until you've
# verified litmark.org as a sending domain in Resend; then switch to
# something like "LitMark <login@litmark.org>"
FROM_EMAIL=LitMark <onboarding@resend.dev>
