# Required — get one at https://console.anthropic.com
ANTHROPIC_API_KEY=

# Optional — raises your OpenAlex rate limit, costs nothing, no signup needed
CONTACT_EMAIL=you@example.com

# Optional — higher Semantic Scholar rate limit: https://www.semanticscholar.org/product/api
SEMANTIC_SCHOLAR_API_KEY=

PORT=3787

# Restrict the API to your own frontend once deployed
ALLOWED_ORIGIN=https://litmark.co.uk
